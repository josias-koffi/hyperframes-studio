{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "share": "disabled",
  "provider": {
    "openrouter": {
      "options": {
        "baseURL": "{env:OPENROUTER_BASE_URL}",
        "apiKey": "{env:OPENROUTER_API_KEY}"
      }
    }
  },
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*.credentials.json": "deny"
    },
    "edit": {
      "*": "allow",
      "*.env": "deny",
      "opencode.json": "deny",
      "CLAUDE.md": "deny",
      ".claude/*": "deny"
    },
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "skill": "allow",
    "todowrite": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "task": "deny",
    "question": "deny",
    "doom_loop": "deny",
    "external_directory": {
      "*": "ask",
      "{env:AGENT_SKILLS_DIR}/**": "allow",
      "{env:HOME}/.claude/skills/**": "allow",
      "{env:HOME}/.config/opencode/skills/**": "allow",
      "{env:HOME}/.agents/skills/**": "allow",
      "{env:TMPDIR}/**": "allow"
    },
    "bash": {
      "*": "allow",
      "cat *.env*": "deny",
      "git push*": "deny",
      "rm -rf /*": "deny",
      "sudo *": "deny",
      "ssh *": "deny",
      "scp *": "deny"
    }
  }
}
