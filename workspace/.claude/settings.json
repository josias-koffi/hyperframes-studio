{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "Skill",
      "TodoWrite",
      "WebFetch",
      "WebSearch",
      "Bash"
    ],
    "deny": [
      "Agent",
      "Task",
      "Bash(git push*)",
      "Bash(rm -rf /*)",
      "Bash(sudo *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.aws/**)"
    ]
  }
}
