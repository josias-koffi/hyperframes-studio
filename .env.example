# Development (`pnpm dev`): copy to .env. The app (`pnpm desktop`) sets its own folders, ports and secrets, and
# reads only the keys and tool settings below from this file.

# Data of `pnpm dev`, relative to the repository: embedded Postgres (PGlite) and the files (uploads, renders).
DATABASE_DIR=.data/database
STORAGE_DIR=.data/storage

# HyperFrames workspace of the agents and the renders (videos/<slug>), synced from the skeleton on start.
WORKSPACE_DIR=.workspace
WORKSPACE_SKELETON_DIR=workspace
PROMPTS_DIR=prompts

# API (the core process) and front. Presigned URLs of the storage point to the API.
PORT=3343
API_URL=http://127.0.0.1:3343
WEB_URL=http://localhost:3010
# `pnpm dev` signs in by opening http://localhost:3010/api/auth/desktop?token=<this> (the app draws one per launch).
DESKTOP_LOGIN_TOKEN=dev
DESKTOP_USER_EMAIL=studio@localhost

# HyperFrames CLI of the render worker: the version the workspace pins.
HYPERFRAMES_BIN=npx --yes hyperframes@0.8.134
# Chrome GPU mode of the HyperFrames CLI (`check`, `snapshot`, `render`), read by the render worker and by the agents'
# commands. Empty = auto (the GPU when there is one). `software` on a machine whose GPU probe passes but whose
# captures fail (AMD Radeon 740M: empty frames at render, Chrome crash or hang at check).
PRODUCER_BROWSER_GPU_MODE=

# Claude Code: the person's own subscription, through the `claude` command logged in on this machine.
# CLAUDE_CODE_OAUTH_TOKEN (`claude setup-token`) replaces that session; never an Anthropic API key.
CLAUDE_CODE_OAUTH_TOKEN=
CLAUDE_MODEL=
# Brief and media follow a recipe and run on Sonnet by default; storyboard and build use CLAUDE_MODEL (opus if empty).
# CLAUDE_MODEL_BRIEF / _STORYBOARD / _MEDIA / _BUILD override one step.
# A build whose check fails twice goes to CLAUDE_MODEL_ESCALATION (opus if empty).
CLAUDE_MODEL_ESCALATION=
CLAUDE_STEP_TIMEOUT_MS=3600000

# OpenCode (models on OpenRouter). The app runs the `opencode-ai` it installs; `pnpm dev` runs this command.
OPENCODE_BIN=opencode
# `opencode serve` (0.6 to 1.3 GB) stops after this long without a turn; it restarts in about a second.
OPENCODE_IDLE_MS=60000
# Jobs run in parallel (Claude Code turns stay one at a time), each about 1.7 GB with OpenCode and Chrome.
AGENT_CONCURRENCY=1

# OpenRouter: the key stays in the core, whose proxy hands the agents and scripts/audio.mjs a token per job.
# The audio models below are the defaults written into the workspace .env (see workspace/CLAUDE.md).
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
TTS_MODEL=mistralai/voxtral-mini-tts-2603
TTS_VOICE=fr_marie_neutral
TTS_PEAK_DB=-1
MUSIC_MODEL=google/lyria-3-clip-preview
# Blocks engine for an owner on Claude Code (on OpenCode, the models chosen in the AI settings are used):
# the structured calls, the model they fall back to after two failures, and a model with vision for the visual check.
BLOCKS_MODEL=
ESCALATION_MODEL=
VISUAL_MODEL=

# fal (realistic créations): the key stays in the core, whose proxy hands scripts/shots.mjs a token per job. On the
# desktop app each person uses their own fal key and contracts with fal directly (US company, no EU region).
FAL_KEY=
# To try realistic créations without a key nor spending: `node scripts/fake-fal.mjs`, then FAL_KEY=fake and
# FAL_QUEUE_URL=http://127.0.0.1:8787.
FAL_QUEUE_URL=https://queue.fal.run

# Postiz (lot 5)
POSTIZ_URL=
POSTIZ_API_KEY=

# HyperFrames engine behind the editor (apps/hf-studio), called by the API only (the window goes through the API).
HF_STUDIO_URL=http://127.0.0.1:3344
HF_STUDIO_TOKEN=
