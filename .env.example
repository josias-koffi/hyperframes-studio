# Local development (`pnpm infra:up` then `pnpm dev`). Copy to .env.
# In staging/production these come from the manifest (vars) and the GitHub environment secrets.

# `pglite:<folder>` and `memory` run Postgres and the queues inside the process (the desktop app, apps/desktop).
DATABASE_URL=postgresql://studio:studio@localhost:5447/studio
REDIS_URL=redis://localhost:6390

# MinIO (S3). S3_PUBLIC_ENDPOINT is what presigned URLs handed to the browser point to.
# STORAGE_DIR instead keeps the files in that folder, served by the API under /files (the desktop app).
S3_ENDPOINT=http://localhost:9120
S3_PUBLIC_ENDPOINT=http://localhost:9120
S3_BUCKET=studio
MINIO_ROOT_USER=studio
MINIO_ROOT_PASSWORD=studio-secret

# HyperFrames workspace shared by the api and the workers (videos/<slug>).
WORKSPACE_DIR=.workspace
WORKSPACE_SKELETON_DIR=workspace
PROMPTS_DIR=prompts

# API / web
PORT=3343
API_URL=http://localhost:3343
WEB_URL=http://localhost:3010

# Render worker: the image installs the HyperFrames CLI globally; on a dev machine use the version the workspace pins.
HYPERFRAMES_BIN=npx --yes hyperframes@0.8.134
# Chrome GPU mode of the HyperFrames CLI (`check`, `snapshot`, `render`), read by the render worker and by Claude's
# commands. Empty = auto (probes the GPU, software without one, as in the images). `software` on a machine whose GPU
# probe passes but whose captures fail (AMD Radeon 740M: empty frames at render, Chrome crash or hang at check).
PRODUCER_BROWSER_GPU_MODE=

# Claude runner: subscription token from `claude setup-token` (never an Anthropic API key).
# Locally, leave it empty to use the `claude` session already logged in on this machine.
CLAUDE_CODE_OAUTH_TOKEN=
CLAUDE_JOBS_ENABLED=true
CLAUDE_MODEL=
# Brief and media follow a recipe and run on Sonnet by default; storyboard and build use CLAUDE_MODEL (opus if empty).
# CLAUDE_MODEL_BRIEF / _STORYBOARD / _MEDIA / _BUILD override one step.
CLAUDE_STEP_TIMEOUT_MS=3600000
# Backends: OpenCode (OpenRouter, platform key below) for everyone, Claude Code (subscription) for admins only.
# CLAUDE_CODE_ENABLED=false hides Claude Code where the subscription must not be used (staging).
CLAUDE_CODE_ENABLED=true
OPENCODE_BIN=opencode
# A client's `opencode serve` (0.6 to 1.3 GB) stops after this long without a turn; it restarts in about a second.
OPENCODE_IDLE_MS=60000
# Jobs run in parallel (Claude Code turns stay one at a time), each about 1.7 GB with its OpenCode server and Chrome.
AGENT_CONCURRENCY=1
# uid (the image): each client's agent runs under its own Unix uid through `sudo agent-exec`, and reads neither
# another client's videos nor this environment. off (local): agents run as you, with a cleaned environment.
AGENT_SANDBOX=off
# Agent homes (<dir>/<uid>: OpenCode sessions, private tmp). Default: <tmp>/studio-agents.
AGENT_HOMES_DIR=

# OpenRouter: the key stays in the runner, whose proxy hands agents and scripts/audio.mjs a token of their own.
# The audio models below are the defaults written into the workspace .env (see workspace/CLAUDE.md).
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
TTS_MODEL=mistralai/voxtral-mini-tts-2603
TTS_VOICE=fr_marie_neutral
TTS_PEAK_DB=-1
MUSIC_MODEL=google/lyria-3-clip-preview

# Postiz (lot 5)
POSTIZ_URL=
POSTIZ_API_KEY=

# HyperFrames engine behind the editor (apps/hf-studio), called by the API only (the browser goes through the API).
HF_STUDIO_URL=http://localhost:3344
HF_STUDIO_TOKEN=

# Authentication (passwordless, magic link by e-mail). The session cookie is set on WEB_URL's origin.
# AUTH_SESSION_SECRET signs the sessions: required in production (`openssl rand -base64 48`).
AUTH_SESSION_SECRET=
AUTH_COOKIE_NAME=framesmith_session
AUTH_MAGIC_LINK_TTL_MINUTES=15
AUTH_SESSION_TTL_DAYS=7

# E-mails (sign-in links) over SMTP, Resend's endpoint by default. Empty = sending is off (sign-in answers 503).
SMTP_PROVIDER=resend
SMTP_SERVER=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=
EMAIL_FROM="Framesmith <no-reply@example.com>"
EMAIL_REPLY_TO=
