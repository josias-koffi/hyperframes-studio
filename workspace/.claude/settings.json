{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "Skill",
      "TodoWrite",
      "WebFetch",
      "WebSearch",
      "Bash(npm run *)",
      "Bash(npx hyperframes *)",
      "Bash(npx --yes hyperframes*)",
      "Bash(hyperframes *)",
      "Bash(sh scripts/new-video.sh *)",
      "Bash(ffmpeg *)",
      "Bash(ffprobe *)",
      "Bash(curl *)",
      "Bash(node *)",
