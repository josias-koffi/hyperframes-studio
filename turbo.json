{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "dist/**"] },
    "dev": { "cache": false, "persistent": true, "passThroughEnv": ["DESKTOP_LOGIN_TOKEN", "DESKTOP_USER_EMAIL"] },
    "lint": { "dependsOn": ["^build"] },
    "typecheck": { "dependsOn": ["^build"] },
    "test": { "dependsOn": ["^build"], "outputs": ["coverage/**"] }
  }
}
