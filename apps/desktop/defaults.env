# Defaults of the installed app, shipped in resources/runtime/: the person's own .env (in the app's data folder)
# overrides any of them.

# Chrome renders in software for the HyperFrames CLI (`check`, `snapshot`, `render`): with the GPU, some machines
# (AMD Radeon 740M) crash Chrome on a composition with a video, or capture empty frames. Slower, but deterministic.
PRODUCER_BROWSER_GPU_MODE=software
