{
  "id": "ed-list",
  "family": "editorial",
  "name": "Sommaire éditorial",
  "description": "Un titre à empattements puis deux ou trois points numérotés 01, 02, 03 en italique couleur d'accent, séparés par des filets qui se tracent, comme un sommaire de magazine.",
  "useWhen": "Pour deux ou trois bénéfices, raisons ou étapes courtes, sur un ton posé. Une idée par point.",
  "props": {
    "title": { "type": "text", "label": "Titre au-dessus de la liste", "maxLength": 40 },
    "item1": { "type": "text", "label": "Premier point", "maxLength": 42 },
    "item2": { "type": "text", "label": "Deuxième point", "maxLength": 42 },
    "item3": { "type": "text", "label": "Troisième point (facultatif)", "maxLength": 42, "required": false, "default": "" },
    "accent": { "type": "color", "label": "Couleur des numéros", "required": false, "default": "#9E1B32" },
    "background": { "type": "color", "label": "Couleur de fond (papier)", "required": false, "default": "#F3EFE6" },
    "textColor": { "type": "color", "label": "Couleur du texte (encre)", "required": false, "default": "#1A1714" }
  },
  "duration": { "min": 3, "max": 8, "default": 5 },
  "example": { "title": "Pourquoi ça marche", "item1": "Prêt en cinq minutes", "item2": "Aucune compétence requise", "item3": "Résultat pro garanti" },
  "sfx": [{ "sounds": ["sfx-tone-step-1", "sfx-tone-step-2", "sfx-tone-step-3"], "at": 0.7, "each": { "props": ["item1", "item2", "item3"], "stepMax": 0.7, "stepShare": 0.5 } }]
}
