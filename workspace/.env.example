# Fournisseurs IA pour la génération audio (voix off + musique).
# Copier en .env et renseigner la clé : cp .env.example .env

# OpenRouter — passerelle unique pour la voix off et la musique
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Voix off (TTS) — Mistral Voxtral Mini TTS, endpoint /audio/speech
TTS_MODEL=mistralai/voxtral-mini-tts-2603
TTS_VOICE=fr_marie_neutral
# Crête cible après normalisation (la sortie brute Voxtral est vers -12,5 dB)
TTS_PEAK_DB=-1

# Musique — Google Lyria 3 Clip
MUSIC_MODEL=google/lyria-3-clip-preview
